<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color"
    tools:context=".Fragmentos.FragmentPerfil">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/imgPerfil"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@drawable/ic_launcher_background"
                android:padding="2dp"
                app:strokeColor="@color/red"
                app:strokeWidth="2dp"
                app:shapeAppearanceOverlay="@style/CircleImage"
                android:scaleType="centerCrop"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                    android:id="@+id/txtUsername"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/Txt_username"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/Btn_editar"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        app:icon="@drawable/ic_editar"
                        app:iconPadding="0dp"
                        app:iconGravity="textStart"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:padding="0dp"
                        app:cornerRadius="12dp"
                        app:backgroundTint="@color/red"
                        app:iconTint="@color/white" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/Txt_entrenos"
                            android:textSize="12sp"
                            android:textColor="@color/text_primary"/>
                        <TextView
                            android:id="@+id/txtNumEntrenos"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/Txt_num_entrenos"
                            android:textStyle="bold"
                            android:textSize="16sp"
                            android:textColor="@color/text_primary"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/Txt_seguidores"
                            android:textSize="12sp"
                            android:textColor="@color/text_primary"/>
                        <TextView
                            android:id="@+id/txtNumSeguidores"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/Txt_num_seguidores"
                            android:textStyle="bold"
                            android:textSize="16sp"
                            android:textColor="@color/text_primary"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/Txt_siguiendo"
                            android:textSize="12sp"
                            android:textColor="@color/text_primary"/>
                        <TextView
                            android:id="@+id/txtNumSiguiendo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/Txt_num_siguiendo"
                            android:textStyle="bold"
                            android:textSize="16sp"
                            android:textColor="@color/text_primary"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/txtHorasSemana"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/Txt_horas_semana"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginBottom="10dp"/>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="200dp"
            app:cardCornerRadius="12dp"
            app:cardBackgroundColor="#80FFFFFF"
            app:strokeWidth="0dp"
            android:layout_marginBottom="16dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/Txt_grafica"
                    android:textColor="#80FFFFFF"
                    android:layout_centerInParent="true"/>

                <View
                    android:layout_width="20dp"
                    android:layout_height="80dp"
                    android:background="@color/red"
                    android:layout_alignParentBottom="true"
                    android:layout_margin="20dp"
                    android:layout_alignParentEnd="true"/>
                <View
                    android:layout_width="20dp"
                    android:layout_height="50dp"
                    android:background="@color/red"
                    android:layout_alignParentBottom="true"
                    android:layout_marginBottom="20dp"
                    android:layout_marginEnd="50dp"
                    android:layout_alignParentEnd="true"/>
            </RelativeLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFiltroDuracion"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="@string/Txt_btn_duracion"
                app:cornerRadius="20dp"
                android:textSize="12sp"
                app:backgroundTint="@color/red"
                android:textColor="@color/white"
                android:layout_marginEnd="8dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFiltroVolumen"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="@string/Txt_btn_volumen"
                app:cornerRadius="20dp"
                android:textSize="12sp"
                app:backgroundTint="@color/gray"
                android:textColor="@color/text_primary"
                android:layout_marginEnd="8dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFiltroRepeticiones"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="@string/Txt_btn_repeticiones"
                app:cornerRadius="20dp"
                android:textSize="12sp"
                app:backgroundTint="@color/gray"
                android:textColor="@color/text_primary"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardEstadisticas"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_weight="1"
                    app:cardCornerRadius="12dp"
                    app:cardBackgroundColor="@color/gray"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:padding="16dp">
                        <ImageView
                            android:src="@android:drawable/ic_menu_sort_by_size"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            app:tint="@color/text_primary"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/Txt_estadisticas"
                            android:layout_marginStart="12dp"
                            android:textColor="@color/text_primary"
                            android:textStyle="bold"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardEjercicios"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_weight="1"
                    app:cardCornerRadius="12dp"
                    app:cardBackgroundColor="@color/gray"
                    android:layout_marginStart="8dp"
                    android:clickable="true"
                    android:focusable="true">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:padding="16dp">
                        <ImageView
                            android:src="@android:drawable/ic_menu_rotate"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            app:tint="@color/text_primary"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/Txt_ejercicios"
                            android:layout_marginStart="12dp"
                            android:textColor="@color/text_primary"
                            android:textStyle="bold"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardMedidas"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_weight="1"
                    app:cardCornerRadius="12dp"
                    app:cardBackgroundColor="@color/gray"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:padding="16dp">
                        <ImageView
                            android:src="@android:drawable/ic_menu_my_calendar"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            app:tint="@color/text_primary"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/Txt_medidas"
                            android:layout_marginStart="12dp"
                            android:textColor="@color/text_primary"
                            android:textStyle="bold"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardCalendario"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_weight="1"
                    app:cardCornerRadius="12dp"
                    app:cardBackgroundColor="@color/gray"
                    android:layout_marginStart="8dp"
                    android:clickable="true"
                    android:focusable="true">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:padding="16dp">
                        <ImageView
                            android:src="@android:drawable/ic_menu_month"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            app:tint="@color/text_primary"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/Txt_calendario"
                            android:layout_marginStart="12dp"
                            android:textColor="@color/text_primary"
                            android:textStyle="bold"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/Btn_cerrar_sesion"
                android:text="@string/Btn_cerrar_sesion"
                android:textAllCaps="true"
                android:layout_width="match_parent"
                android:layout_marginTop="12dp"
                android:layout_height="@dimen/m_button_height"
                app:cornerRadius="12dp"
                app:backgroundTint="@color/red"
                android:textColor="@color/white"/>

        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>